---====== Load spawner (your modified copy of Vynixu's spawner, with built-in Jumpscare support) ======---

local Spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/Tricot676/Doors-Modes/refs/heads/main/Modern%20Doors%20Entity%20Spawner/init.luau"))()

---====== Create entity ======---

local entity = Spawner:Create({
    Entity = {
        Name = "Depth", -- Custom name of your entity
        Asset = "https://github.com/Tricot676/Doors-Hard-Mode/blob/main/Models/depth.rbxm?raw=true",
        HeightOffset = 1,
    },
    Movement = {
        Speed = 350, -- Percentage, 100 = default Rush speed
        Delay = 5, -- Time before it starts moving (seconds)
        Reversed = false,
    },
    Damage = {
        Enabled = true,
        IgnoreHiding = false,
        Range = 500,
        Amount = 125,
    },
    Rebounding = {
        Enabled = true,
        Type = "Ambush",
        Min = 2,
        Max = 2,
        Delay = 0,
    },
    Lights = {
        Flicker = {
            Enabled = true,
            Duration = 1,
        },
        Shatter = true,
        Repair = false,
    },
    Earthquake = {
        Enabled = false,
    },
    CameraShake = {
        Enabled = true,
        Values = {5, 15, 0.1, 1}, -- Magnitude, Roughness, FadeIn, FadeOut
        Range = 100,
    },
    Jumpscare = {
        Enabled = true,
        Image1 = "rbxassetid://18772587322", -- Image1 (tease)
        Image2 = "rbxassetid://18772587322", -- Image2 (scare)
        Sound1 = { Id = 10483790459, Properties = { Volume = 0.5 } }, -- Only plays if Tease is enabled
        Sound2 = { Id = 5263560566, Properties = { Volume = 0.5 } },
        Shake = true,
        Flashing = {
            Enabled = true,
            Color = Color3.fromRGB(50, 155, 108),
        },
        Tease = {
            Enabled = false,
            Min = 1,
            Max = 3,
        },
    },
    Death = {
        Type = "Guiding", -- "Curious"
        Hints = {"i couldnt figure out who you die", "entity is faster than rush and ambush", "And he can rebound 2 Times", "use what you leared from Ambush and rush tho.", "dont die "},
        Cause = "Depth",
    },
})

---====== Callbacks ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    print("Entity has entered room:", room.Name, firstTime and "for the first time" or "again")
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
    if startOfRebound == true then
        print("Entity has started rebounding")
    else
        print("Entity has finished rebounding")
    end
end)

entity:SetCallback("OnDespawned", function()
    print("Entity has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        print("Entity has killed the player")
    end
end)

---====== Run entity ======---

entity:Run(true)
